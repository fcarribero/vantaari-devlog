---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../../lib/formatDate';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('devlogEn')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const esHref = page.currentPage === 1 ? `${base}archivo/` : `${base}archivo/${page.currentPage}/`;
---
<Layout title="All posts" lang="en" switchHref={esHref}>
  <h1>All posts</h1>
  <ul class="archive-list">
    {page.data.map((post) => (
      <li>
        <a href={`${base}en/devlog/${post.id}/`}>[{post.data.category.toUpperCase()}] {post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'en-US')}</time>
      </li>
    ))}
  </ul>
  <p class="archive-nav">
    {page.url.prev && <a href={page.url.prev}>&larr; Newer</a>}
    {page.url.prev && page.url.next && ' · '}
    {page.url.next && <a href={page.url.next}>Older &rarr;</a>}
  </p>
</Layout>

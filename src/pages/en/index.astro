---
import Layout from '../../layouts/Layout.astro';
import PostView from '../../components/PostView.astro';
import { getCollection, render } from 'astro:content';

const posts = (await getCollection('devlogEn')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = posts[0];
const prev = posts[1];
const { Content } = await render(latest);
const base = import.meta.env.BASE_URL;
---
<Layout title="Devlog" lang="en" switchHref={base} activeSlug={latest.id} showSidebar showBanner>
  <PostView
    title={latest.data.title}
    date={latest.data.date}
    category={latest.data.category}
    locale="en-US"
    prevHref={prev ? `${base}en/devlog/${prev.id}/` : undefined}
    prevLabel={prev?.data.title}
  >
    <Content />
  </PostView>
</Layout>

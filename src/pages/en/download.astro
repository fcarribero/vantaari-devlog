---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Download" lang="en" switchHref={`${base}download/`}>
  <h1>Download Vantaari</h1>
  <p>Latest version: <span class="version">v0.1.0</span></p>
  <p>
    <button type="button" class="download-btn" disabled>Download v0.1.0 (Windows)</button>
  </p>
  <p>There's no build available to download yet. Check back soon.</p>
</Layout>

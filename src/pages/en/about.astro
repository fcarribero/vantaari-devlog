---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="About" lang="en" switchHref={`${base}about/`}>
  <h1>About Space4X</h1>
  <p>
    Space4X is a single-player 4X space game in the style of EVE Online —
    exploration, industry, trade, and combat across a persistent galaxy.
    This devlog tracks its development.
  </p>
</Layout>

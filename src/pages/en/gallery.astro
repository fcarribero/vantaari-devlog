---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp}'
);
const images = await Promise.all(
  Object.entries(imageModules).map(async ([path, resolve]) => ({
    path,
    image: (await resolve()).default,
  }))
);
const base = import.meta.env.BASE_URL;
---
<Layout title="Gallery" lang="en" switchHref={`${base}gallery/`}>
  <h1>Gallery</h1>
  {images.length === 0 && <p>No screenshots yet. Check back soon.</p>}
  <div class="grid">
    {images.map(({ path, image }, index) => (
      <a href={image.src} class="lightbox-trigger" data-full={image.src} data-index={index}>
        <Image src={image} alt="Vantaari screenshot" width={400} />
      </a>
    ))}
  </div>
  <div id="lightbox" class="lightbox hidden">
    <button id="lightbox-close" class="lightbox-btn lightbox-close" aria-label="Close">&times;</button>
    <button id="lightbox-fullscreen" class="lightbox-btn lightbox-fullscreen">Fullscreen</button>
    <button id="lightbox-prev" class="lightbox-btn lightbox-nav lightbox-prev" aria-label="Previous">&larr;</button>
    <img id="lightbox-img" src="" alt="" />
    <button id="lightbox-next" class="lightbox-btn lightbox-nav lightbox-next" aria-label="Next">&rarr;</button>
    <span id="lightbox-counter" class="lightbox-counter"></span>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .grid a {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(2, 7, 13, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox.hidden {
    display: none;
  }
  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
  }
  .lightbox:fullscreen {
    background: #02070d;
  }
  .lightbox:fullscreen img {
    max-width: 100vw;
    max-height: 100vh;
  }

  .lightbox-btn {
    position: absolute;
    background: rgba(2, 7, 13, 0.7);
    border: 1px solid var(--color-line-dim);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem 0.8rem;
  }
  .lightbox-btn:hover {
    color: var(--color-text-highlight);
    border-color: var(--color-line);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
    font-size: 1.3rem;
    padding: 0.3rem 0.7rem;
  }
  .lightbox-fullscreen {
    top: 1rem;
    right: 4rem;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-prev {
    left: 1rem;
  }
  .lightbox-next {
    right: 1rem;
  }
  .lightbox-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lightbox-trigger'));
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const counter = document.getElementById('lightbox-counter');
  const btnPrev = document.getElementById('lightbox-prev');
  const btnNext = document.getElementById('lightbox-next');
  const btnClose = document.getElementById('lightbox-close');
  const btnFullscreen = document.getElementById('lightbox-fullscreen');
  let currentIndex = 0;

  function show(index: number) {
    if (triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    lightboxImg.src = triggers[currentIndex].dataset.full ?? '';
    if (counter) counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
    lightbox?.classList.remove('hidden');
  }

  function close() {
    lightbox?.classList.add('hidden');
    if (document.fullscreenElement) document.exitFullscreen();
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      show(index);
    });
  });

  btnPrev?.addEventListener('click', () => show(currentIndex - 1));
  btnNext?.addEventListener('click', () => show(currentIndex + 1));
  btnClose?.addEventListener('click', () => close());
  btnFullscreen?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      lightbox?.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(currentIndex - 1);
    if (e.key === 'ArrowRight') show(currentIndex + 1);
  });
</script>

---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Acerca de" lang="es" switchHref={`${base}en/about/`}>
  <h1>Acerca de Space4X</h1>
  <p>
    Space4X es un juego 4X espacial para un jugador, al estilo de EVE Online —
    exploración, industria, comercio y combate en una galaxia persistente.
    Este devlog sigue su desarrollo.
  </p>
</Layout>

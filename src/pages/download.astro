---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Descargar" lang="es" switchHref={`${base}en/download/`}>
  <h1>Descargar Vantaari</h1>
  <p>Última versión: <span class="version">v0.1.0</span></p>
  <p>
    <button type="button" class="download-btn" disabled>Descargar v0.1.0 (Windows)</button>
  </p>
  <p>Todavía no hay una build disponible para descargar. Pronto va a estar lista.</p>
</Layout>

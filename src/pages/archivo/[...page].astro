---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/formatDate';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('devlogEs')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const enHref = page.currentPage === 1 ? `${base}en/archive/` : `${base}en/archive/${page.currentPage}/`;
---
<Layout title="Todos los posts" lang="es" switchHref={enHref}>
  <h1>Todos los posts</h1>
  <ul class="archive-list">
    {page.data.map((post) => (
      <li>
        <a href={`${base}devlog/${post.id}/`}>[{post.data.category.toUpperCase()}] {post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'es-AR')}</time>
      </li>
    ))}
  </ul>
  <p class="archive-nav">
    {page.url.prev && <a href={page.url.prev}>&larr; Más recientes</a>}
    {page.url.prev && page.url.next && ' · '}
    {page.url.next && <a href={page.url.next}>Más antiguos &rarr;</a>}
  </p>
</Layout>

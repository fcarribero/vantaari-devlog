---
import Layout from '../../layouts/Layout.astro';
import PostView from '../../components/PostView.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('devlogEs')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: posts[index + 1], next: posts[index - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---
<Layout title={post.data.title} lang="es" switchHref={`${base}en/devlog/${post.id}/`} activeSlug={post.id} showSidebar>
  <PostView
    title={post.data.title}
    date={post.data.date}
    category={post.data.category}
    locale="es-AR"
    prevHref={prev ? `${base}devlog/${prev.id}/` : undefined}
    prevLabel={prev?.data.title}
    nextHref={next ? `${base}devlog/${next.id}/` : undefined}
    nextLabel={next?.data.title}
  >
    <Content />
  </PostView>
</Layout>
